{
	log {
		format filter {
			request>uri query {
				replace access_token REDACTED
			}
			wrap json
		}
	}
}

:6005 {
	@hs path /api/* /plivo/* /status /openapi.json
	handle @hs {
		reverse_proxy {$HS_UPSTREAM}
	}
	handle {
		root * /srv
		@console path_regexp ^/(signin|you|desk|floor|conversations|tasks|teams|queues|skills|statuses|contacts|outbound|hours|workload|dispositions|agents|numbers|plivo)(/[A-Za-z0-9_-]+)*/?$
		@asset {
			path /assets/*
			file
		}
		@page not path /assets/*
		header @asset Cache-Control "public, max-age=31536000, immutable"
		header @page Cache-Control no-cache
		rewrite @console /index.html
		file_server
	}
}
