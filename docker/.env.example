# Copy to docker/.env (`cp docker/.env.example docker/.env`); docker compose passes it to the service. Never commit .env.

# Required
DATABASE_URL=postgresql://hs:hs@postgres:5432/hs
REDIS_URL=redis://redis:6379/0
# A public URL that reaches this service on :6004 (Plivo calls it back), e.g. a tunnel.
PUBLIC_BASE_URL=https://hs.example.com
# Bearer key for the operator routes (/api/v1/tenants). Generate: openssl rand -base64 32
HS_OPERATOR_KEY=
# Key material for Plivo tokens at rest and signed recording URLs. Generate: openssl rand -base64 32
HS_SECRET_KEY=

# Optional (defaults shown)
# Host port docker compose publishes the service on (it listens on 6004 inside the container).
PORT=6004
PLIVO_API_URL=https://api.plivo.com
PLIVO_MEDIA_URL=https://media.plivo.com
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=
EVENT_RETENTION_DAYS=90
# Comma-separated hosts whose webhooks may use http (local receivers only).
WEBHOOK_PRIVATE_HOSTS=
# Seconds a webhook delivery may take before it is retried.
WEBHOOK_DEADLINE=10
# Prometheus metrics port; 0 turns it off.
METRICS_PORT=9100
LOG_LEVEL=INFO
# Played to callers queued or on hold when a queue sets no hold_music; empty plays nothing.
HOLD_MUSIC_URL=https://s3.amazonaws.com/plivocloud/music.mp3
